APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Paksa HTTPS (redirect http->https, cookie secure, HSTS). Kosongkan = otomatis:
# AKTIF saat APP_ENV=production, MATI selain itu. Set 'true'/'false' untuk override.
# FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============ JARINGAN BLOCKCHAIN — BNB Smart Chain Testnet (chainId 97) ============
CHAIN_ID=97
CHAIN_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545/
CHAIN_EXPLORER_URL=https://testnet.bscscan.com
CHAIN_NAME="BNB Smart Chain Testnet"

# Alamat kontrak (isi setelah redeploy ke BSC Testnet)
TLKM_ADDRESS=__ISI_SETELAH_REDEPLOY__
PAYMENT_GATEWAY_ADDRESS=__ISI_SETELAH_REDEPLOY__
DONATION_POOL_ADDRESS=__ISI_SETELAH_REDEPLOY__
COMMUNITY_WALLET_ADDRESS=__ISI_SETELAH_REDEPLOY__
# Paylater (kredit berjaminan on-chain, DEMO). Isi setelah deploy TlkmPaylater.sol.
PAYLATER_ADDRESS=
PAYLATER_RATE_TLKM_PER_BNB=1000000

# ============ HARDENING PRODUKSI (go-live) — WAJIB sebelum deploy ============
# Saat deploy ke produksi, ubah APP_ENV & APP_DEBUG di atas menjadi:
#   APP_ENV=production
#   APP_DEBUG=false
# Secret enkripsi embedded wallet — WAJIB diisi di produksi (secret kuat & acak,
# TERPISAH dari APP_KEY). JANGAN diubah setelah ada wallet (kunci enkripsi turunan).
WALLET_ENC_SECRET=
# Cookie sesi hanya dikirim lewat HTTPS (aktifkan di produksi di belakang HTTPS).
SESSION_SECURE_COOKIE=true
