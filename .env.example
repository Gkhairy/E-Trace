APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Paksa HTTPS (redirect http->https, cookie secure, HSTS). Kosongkan = otomatis:
# AKTIF saat APP_ENV=production, MATI selain itu. Set 'true'/'false' untuk override.
# FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============ JARINGAN BLOCKCHAIN — BNB Smart Chain Testnet (chainId 97) ============
CHAIN_ID=97
CHAIN_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545/
CHAIN_EXPLORER_URL=https://testnet.bscscan.com
CHAIN_NAME="BNB Smart Chain Testnet"

# Feed "Transfer TLKM" di Explorer (event Transfer via eth_getLogs, tanpa API key).
# RPC utama memblokir getLogs, jadi pakai RPC yang mengizinkannya (default publicnode).
CHAIN_LOGS_RPC_URL=https://bsc-testnet-rpc.publicnode.com
EXPLORER_TRANSFERS_LOOKBACK=5000

# Alamat kontrak (isi setelah redeploy ke BSC Testnet)
TLKM_ADDRESS=__ISI_SETELAH_REDEPLOY__
PAYMENT_GATEWAY_ADDRESS=__ISI_SETELAH_REDEPLOY__
DONATION_POOL_ADDRESS=__ISI_SETELAH_REDEPLOY__
COMMUNITY_WALLET_ADDRESS=__ISI_SETELAH_REDEPLOY__
# Paylater (kredit berjaminan on-chain DENGAN BUNGA, DEMO). Isi setelah deploy TlkmPaylater.sol.
PAYLATER_ADDRESS=
PAYLATER_RATE_TLKM_PER_BNB=1000000
PAYLATER_INTEREST_BPS=300

# ============ HARDENING PRODUKSI (go-live) — WAJIB sebelum deploy ============
# Saat deploy ke produksi, ubah APP_ENV & APP_DEBUG di atas menjadi:
#   APP_ENV=production
#   APP_DEBUG=false
# Secret enkripsi embedded wallet — WAJIB diisi di produksi (secret kuat & acak,
# TERPISAH dari APP_KEY). JANGAN diubah setelah ada wallet (kunci enkripsi turunan).
WALLET_ENC_SECRET=
# Cookie sesi hanya dikirim lewat HTTPS (aktifkan di produksi di belakang HTTPS).
SESSION_SECURE_COOKIE=true

# ============ AI AUTO-SETTLEMENT + GARANSI TEPAT WAKTU (DEMO testnet) ============
# Fitur asuransi pengiriman parametrik + penyelesaian escrow otomatis oleh AI.
# Aman-nonaktif: bila INSURANCE_ENABLED=false ATAU INSURANCE_POOL_ADDRESS kosong,
# seluruh alur asuransi mati. Bila KEEPER_ARBITER_PRIVATE_KEY kosong, auto-settlement
# mati (keputusan AI tetap dicatat, order ditandai 'held' untuk ditinjau pengawas).
INSURANCE_ENABLED=false
INSURANCE_PREMIUM_TLKM=2
# Wallet custodial platform pembayar klaim (menampung premi & membayar payout).
INSURANCE_POOL_ADDRESS=
# Private key wallet pool di atas (server menandatangani payout). JANGAN commit nilai asli.
INSURANCE_POOL_PRIVATE_KEY=
INSURANCE_ETA_BUFFER_DAYS=3
INSURANCE_GRACE_DAYS=2
INSURANCE_PAYOUT=shipping_refund
INSURANCE_PAYOUT_CAP_TLKM=30
INSURANCE_DAILY_PAYOUT_CAP_TLKM=500

# Ambang keyakinan AI untuk auto-eksekusi; di atas nilai order ini → eskalasi pengawas.
AI_MIN_CONFIDENCE=0.8
AI_MAX_AUTO_AMOUNT_TLKM=1000

# Private key wallet ARBITER (pengawas otomatis) — WAJIB sudah dipasang via
# PaymentGatewayV3.setArbiter(<alamat wallet ini>). Kosong = auto-settlement mati.
# JANGAN commit nilai asli.
KEEPER_ARBITER_PRIVATE_KEY=

# Wallet penerima ONGKIR (custodial platform/logistik). Ongkir dibayar sebagai transfer
# TLKM TERPISAH dari escrow produk saat checkout. Kosong = fallback ke INSURANCE_POOL_ADDRESS
# (bila itu pun kosong, ongkir tetap estimasi non-on-chain).
SHIPPING_FEE_WALLET=

# Aturan penyelesaian deterministik keeper (tanpa AI):
SETTLE_SHIP_DEADLINE_DAYS=3   # tak dikirim N hari → auto-refund (0 = mati)
SETTLE_AUTO_COMPLETE_DAYS=3   # delivered tapi tak dikonfirmasi M hari → auto-selesai (0 = mati)
SETTLE_FAR_ETA_DAYS=10        # tujuan jauh (eta_days >= ini) TIDAK di-auto-selesaikan

# Cloudflare Turnstile (anti-bot di login/daftar). Aman-nonaktif bila kosong.
# Ambil gratis di dash.cloudflare.com → Turnstile → Add site. site_key publik, secret rahasia.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
