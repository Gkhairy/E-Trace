# Railway memberi port lewat $PORT — disuntikkan entrypoint via envsubst.
user www-data;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;
    tcp_nopush    on;
    keepalive_timeout 65;
    client_max_body_size 12M;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hanya CRAWLER massal yang diblokir. Agen yang dipicu manusia (ChatGPT-User,
    # Perplexity-User — mis. juri menempelkan link ke ChatGPT) sengaja tidak ada di
    # daftar ini; "PerplexityBot" di bawah tidak cocok dengan "Perplexity-User".
    # Crawler AI/scraper yang dikenal. Mereka ditolak di nginx (403) SEBELUM PHP jalan,
    # jadi nyaris tanpa CPU. robots.txt saja tidak cukup: bot membacanya berkala (GPTBot
    # sempat menyisir ribuan halaman produk ~2/detik) dan sebagian mengabaikannya.
    map $http_user_agent $blocked_bot {
        default 0;
        "~*(GPTBot|OAI-SearchBot|CCBot|ClaudeBot|Claude-Web|anthropic-ai|Bytespider|PerplexityBot|Amazonbot|Google-Extended|meta-externalagent|Applebot-Extended|Diffbot|ImagesiftBot|YouBot|omgili)" 1;
    }

    server {
        listen ${PORT};
        server_name _;
        root /app/public;
        index index.php;

        # Railway berada di belakang proxy TLS; Laravel membaca X-Forwarded-*.
        real_ip_header X-Forwarded-For;
        set_real_ip_from 0.0.0.0/0;

        # Aset statis (termasuk foto unggahan yang di-mount dari Volume).
        location = /robots.txt { try_files $uri =404; }

        location ~* \.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff2?|glb|mp4)$ {
            if ($blocked_bot) { return 403; }
            expires 7d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        location / {
            if ($blocked_bot) { return 403; }
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            if ($blocked_bot) { return 403; }
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTPS on;
            fastcgi_read_timeout 60s;
        }

        # Jangan pernah sajikan berkas tersembunyi (.env, .git, dst).
        location ~ /\. { deny all; }
    }
}
